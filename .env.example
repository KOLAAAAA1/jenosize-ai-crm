# ---------------------------------------------------------------------------
# AI CRM MVP — environment template
# Copy to `.env` and fill in real values. NEVER commit the filled-in .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# The app uses the pg driver adapter, so ONE connection string targets any of:
# local Docker, a native local install, a remote server, or Neon serverless.
# Switching targets is just an env change — no code change.
#   DATABASE_URL  app runtime (use the POOLED endpoint on Neon)
#   DIRECT_URL    prisma migrate/seed (direct, non-pooled; = DATABASE_URL when no pooler)
#
# 1) LOCAL DOCKER  (default — `pnpm db:up`):
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"
DIRECT_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"
#
# 2) LOCAL NATIVE / REMOTE SERVER Postgres:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/crm?schema=public"
#   DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/crm?schema=public"
#
# 3) NEON SERVERLESS (migration target — see README "Database configuration"):
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true"
#   DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- AI provider (copilot engine) -------------------------------------------
# The copilot picks a provider by which key is set (OpenRouter preferred):
#   1) OpenRouter (OpenAI-compatible) — active when OPENROUTER_API_KEY is set.
#   2) Anthropic Claude — used when only ANTHROPIC_API_KEY is set.
# With neither key, the copilot returns its deterministic fallback.
#
# OpenRouter (default engine). Model: openai/gpt-oss-120b — billed to your OpenRouter
# credits (the ":free" tier for this model is retired; the paid slug is the working one).
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Anthropic (alternative). Leave unset when using OpenRouter.
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Model id for the ACTIVE provider (overrides the per-provider default).
#   OpenRouter free ($0, rate-limited): google/gemma-4-26b-a4b-it:free
#   OpenRouter paid (stable, ~$0.0002/call): openai/gpt-oss-120b
#   Anthropic: claude-opus-4-8
CRM_AI_MODEL="google/gemma-4-26b-a4b-it:free"

# --- LINE Official Account (Messaging API) ----------------------------------
# From the LINE Developers console for your OA test channel.
LINE_CHANNEL_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LINE_CHANNEL_ACCESS_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# false = use the mock adapter (no real LINE calls) for local dev/tests.
LINE_ENABLED="false"
# Greeting auto-reply is controlled per-contact (Contact.autoReplyEnabled, default
# false) from the contact page — not by an env flag. For a clean test, disable
# Greeting + Auto-reply in LINE OA Manager so the platform doesn't consume the
# single-use replyToken first.
# LIFF self-registration (/liff): the LIFF app id from a LINE Login channel. The
# server derives the Login channel id from its prefix for ID-token verification;
# set LINE_LOGIN_CHANNEL_ID explicitly only if it differs from that prefix.
LINE_LIFF_ID="0000000000-xxxxxxxx"
# LINE_LOGIN_CHANNEL_ID=""

# Rich menu (scripts/setup-rich-menu.ts): after `pnpm line:richmenu -- --apply`,
# set this to the printed MEMBER rich menu id so a user who connects via LIFF is
# auto-switched off the default (guest) menu onto the member menu. Leave blank to
# disable the switch.
# LINE_MEMBER_RICHMENU_ID=""

# LINE inquiry→lead capture (PLAN §5): the User who owns leads auto-created from a
# LINE inquiry. Leave blank to default to the earliest ADMIN/MANAGER user.
# LINE_LEAD_DEFAULT_OWNER_ID=""

# --- Email (optional P1 integration) --------------------------------------
# Email drafts always persist locally. The app refuses to mark a draft "sent"
# until EMAIL_ENABLED=true AND a transport below is fully configured.
EMAIL_ENABLED="false"
EMAIL_FROM_ADDRESS="sales@your-domain.example"

# Transport: "smtp" (send directly — Gmail/Office365/company mail) or "gateway"
# (POST to an external HTTP gateway). Leave unset to auto-pick smtp when SMTP_HOST
# is present, else gateway.
EMAIL_TRANSPORT="smtp"

# SMTP transport — swap provider by changing these values only, no code change.
#   Gmail:      host=smtp.gmail.com     port=465 secure=true   (SMTP_PASSWORD = a
#               Google App Password; requires 2-Step Verification; ~500 sends/day)
#   Office365:  host=smtp.office365.com port=587 secure=false  (STARTTLS)
#   Company:    your mail server's host/port/credentials
# SMTP_USER must match EMAIL_FROM_ADDRESS (or an authorized alias); most providers
# rewrite/return-reject a From that differs from the authenticated account.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="you@your-domain.example"
SMTP_PASSWORD="replace-with-smtp-or-app-password"

# Gateway transport (only when EMAIL_TRANSPORT="gateway") — see docs/EMAIL_INTEGRATION.md
EMAIL_OUTBOUND_WEBHOOK_URL="https://your-email-gateway.example/send"
EMAIL_OUTBOUND_WEBHOOK_TOKEN="replace-with-a-long-gateway-token"
# Shared secret the inbound gateway must send as X-Email-Webhook-Secret to
# POST /api/email/inbound. Keep server-only; do not use NEXT_PUBLIC_.
EMAIL_WEBHOOK_SECRET="replace-with-a-long-inbound-secret"

# --- Auth (seeded demo credentials) -----------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- App --------------------------------------------------------------------
# Public base URL of the deployment (used for webhook + auth callbacks).
APP_URL="http://localhost:3000"

# --- Smoke tests -------------------------------------------------------------
# Defaults target APP_URL with seeded admin credentials.
SMOKE_BASE_URL="http://localhost:3000"
SMOKE_EMAIL="admin@jenosize.demo"
SMOKE_PASSWORD="Demo1234!"
# Optional: set to a mapped Contact.lineUserId to exercise a signed webhook.
SMOKE_LINE_USER_ID=""
SMOKE_EXPECT_LINE_PROCESSED="false"
LINE_EVENTS_LIMIT="20"
LINE_EVENTS_INCLUDE_EMPTY="false"
LINE_BACKFILL_LIMIT="20"
# Optional: set to one WebhookEvent.providerEventId when backfilling a single event.
LINE_BACKFILL_EVENT_ID=""
