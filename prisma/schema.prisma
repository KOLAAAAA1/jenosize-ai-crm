// AI CRM MVP — data model (PLAN.md §3)
// 9 tables. Idempotency + intent are enforced at the DB layer via unique
// constraints and deliberate FK cascade choices, not just in app code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7: connection URLs live in prisma.config.ts (CLI/migrations) and are
  // passed to PrismaClient via the pg driver adapter at runtime (see src/lib/db.ts).
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MANAGER
  SALES
}

enum Stage {
  NEW
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum Source {
  WEBSITE
  MANUAL
  LINE_OA
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  STAGE_CHANGE
  AI_SUGGESTION
  LINE_IN
  LINE_OUT
}

enum MessageChannel {
  LINE
  EMAIL
}

enum MessageDirection {
  IN
  OUT
}

enum MessageStatus {
  RECEIVED
  DRAFT
  APPROVED
  SENT
  FAILED
}

enum SuggestionType {
  SUMMARY
  SCORE
  NEXT_ACTION
  LINE_DRAFT
}

enum SuggestionStatus {
  SUGGESTED
  ACCEPTED
  REJECTED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  INVALID
  FAILED
}

// PII / marketing-consent state for a contact. Drives the AI copilot's opt-out
// handling (SKILL Evaluation Case 3). UNKNOWN is the safe default: still require
// human approval for every outbound reply.
enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum TaskStatus {
  OPEN
  DONE
}

// Lightweight conversation-state marker for the LINE inquiry→lead capture flow
// (PLAN §5 / src/lib/line/inbound-intents.ts). One value for now.
enum PendingIntent {
  AWAITING_INQUIRY
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  role         UserRole @default(SALES)
  passwordHash String
  createdAt    DateTime @default(now())

  ownedLeads   Lead[]        @relation("LeadOwner")
  activities   Activity[]
  tasks        Task[]
  activityLogs ActivityLog[]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  size      String?
  website   String?
  notes     String?
  createdAt DateTime @default(now())

  contacts Contact[]
  leads    Lead[]
}

model Contact {
  id         String  @id @default(cuid())
  companyId  String
  firstName  String
  lastName   String
  email      String?
  phone      String?
  title      String?
  lineUserId String? @unique // LINE → CRM mapping key
  consentStatus ConsentStatus @default(UNKNOWN)
  // Per-contact AI auto-reply switch (sale/admin flips it on the lead's chat box or
  // the contact page). Default TRUE: an inbound LINE message is answered by the AI
  // automatically. Switched off, the OA stays silent and a rep replies by hand from
  // the chat box. See src/lib/line/ai-autoreply.ts.
  autoReplyEnabled Boolean @default(true)
  // Set when the customer taps "ask for more info" on the rich menu; their next
  // message is captured into a Lead and this is cleared (PLAN §5).
  pendingIntent PendingIntent?
  createdAt  DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads    Lead[]
  messages Message[]

  @@index([companyId])
}

model Lead {
  id          String   @id @default(cuid())
  title       String
  companyId   String
  contactId   String
  ownerId     String
  stage       Stage    @default(NEW)
  source      Source   @default(MANUAL)
  valueTHB    Int      @default(0)
  probability Int?     // 0–100; deliberately nullable until a rep qualifies the deal
  expectedCloseAt DateTime?
  score       Int? // 0–100 qualification score (nullable until scored)
  scoreReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  owner       User           @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  activities  Activity[]
  messages    Message[]
  suggestions AiSuggestion[]
  tasks       Task[]

  @@index([companyId])
  @@index([contactId])
  @@index([ownerId])
  @@index([stage])
  @@index([source])
  @@index([expectedCloseAt])
}

// Follow-up tasks / reminders on a lead (PLAN §11.2). Owner-scoped; a due date
// drives the "my tasks due" view. Append-only history is not needed here — a task
// is a small mutable to-do (OPEN ⇄ DONE).
model Task {
  id          String     @id @default(cuid())
  leadId      String
  ownerId     String
  title       String
  dueAt       DateTime? // optional; overdue = OPEN && dueAt < now
  status      TaskStatus @default(OPEN)
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  lead  Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([ownerId, status]) // powers "my open tasks"
  @@index([dueAt])
}

// Immutable timeline. Rows are appended, never updated.
model Activity {
  id        String       @id @default(cuid())
  leadId    String
  userId    String? // nullable: system / AI / inbound-LINE entries have no user
  type      ActivityType
  body      String
  metadata  Json?
  createdAt DateTime     @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
}

model Message {
  id                String           @id @default(cuid())
  leadId            String?
  contactId         String
  channel           MessageChannel   @default(LINE)
  direction         MessageDirection
  providerMessageId String?          @unique // idempotency for inbound LINE
  status            MessageStatus
  body              String
  // LINE messages only use `body`; email messages additionally keep the
  // envelope/subject values needed for a useful timeline and a provider-agnostic
  // outbound/inbound integration.
  subject           String?
  fromAddress       String?
  toAddress         String?
  providerThreadId  String?
  createdAt         DateTime         @default(now())

  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([contactId])
  @@index([status])
}

// AI output is a suggestion, never a confirmed write, until a human acts on it.
model AiSuggestion {
  id        String           @id @default(cuid())
  leadId    String
  type      SuggestionType
  payload   Json
  model     String
  status    SuggestionStatus @default(SUGGESTED)
  createdBy String // "ai:<model>" or "fallback:deterministic"
  createdAt DateTime         @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status])
}

// Dedupe + audit for inbound webhooks (idempotent re-delivery).
model WebhookEvent {
  id              String        @id @default(cuid())
  provider        String        @default("LINE")
  providerEventId String        @unique // dedupe key
  signatureValid  Boolean
  rawPayload      Json
  status          WebhookStatus @default(RECEIVED)
  processedAt     DateTime?
  createdAt       DateTime      @default(now())

  @@index([status])
}

// Audit trail for HTTP API traffic only (src/app/api/**). Server Actions and page
// navigations are deliberately NOT recorded here — this table answers "what hit the
// API", not "what did a user click". Written after the response via `after()`, so a
// logging failure can never turn a good request into a 500.
//
// `Activity` above is the CRM-domain timeline (calls, notes, stage moves) — a
// different concept that happens to share a word; hence the distinct model name.
model ActivityLog {
  id     String @id @default(cuid())
  kind   String @default("api") // "api" = request to /api/**; "page" = a page view
  path   String // pathname only, e.g. /api/ai/copilot (never the full URL)
  method String
  query      Json? // parsed search params, redacted
  payload    Json? // JSON request body, redacted + size-capped; null for GET
  // Null since the switch to proxy-based logging: Next's proxy runs *before* the
  // route handler and has no continuation hook, so the response is never visible to
  // it. Rows written by the old per-route withApiLog wrapper still carry values.
  statusCode Int?
  durationMs Int?
  userId     String? // null for public/unauthenticated endpoints (LINE, LIFF, login)
  ipAddress  String?
  userAgent  String?
  device     String? // derived from the user agent: desktop | mobile | tablet | bot
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([path])
  @@index([kind])
}
